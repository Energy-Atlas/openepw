# Local OpenEPW credentials. Copy to .env and fill only the services you use.
# Loading is explicit: openepw --env-file .env <command>
# Keep .env untracked; never put real credentials in this example.

# NSRDB/NLR downloads require both values.
OPENEPW_NLR_API_KEY=
OPENEPW_NLR_EMAIL=

# Copernicus CDS ERA5/ERA5-Land downloads require a personal access token.
OPENEPW_CDS_KEY=

# Optional paid/commercial Open-Meteo endpoint.
OPENEPW_OPENMETEO_API_KEY=

# Binding REST to a non-loopback interface requires one of these: a bearer token for
# scripted API use, or a site password for the browser UI (remembered 30 days per browser).
OPENEPW_BEARER_TOKEN=
OPENEPW_SITE_PASSWORD=

# Hosted deployments (docs/deploy/render.md): the built chat UI to serve, and the catalog
# seed installed once into an empty data root.
OPENEPW_WEB_ROOT=
OPENEPW_SEED_URL=
OPENEPW_SEED_SHA256=

# Optional local artifact/catalog storage location.
OPENEPW_DATA_ROOT=.local/openepw

# Optional Stage 5/6 agent model tests. Configure only the provider under test.
# Current OpenEPW RuntimeConfig does not export these to the process environment;
# the future harness/test runner must load them explicitly before invoking an SDK.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional LangSmith evaluation/tracing. The console traces when the key exists;
# use openepw-chat --no-trace to suppress it. This flag controls other SDK users.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
